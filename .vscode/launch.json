    "version": "0.2.0",
    "configurations": [
        {
            "name": "运行 GradeHelper (使用默认 config.yaml)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gradehelper/__main__.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "name": "运行 GradeHelper (带参数)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gradehelper/__main__.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--reports",
                "./reports",
                "--template",
                "云安全-课程报告-评分模板.xlsx",
                "-v"
            ]
        }
    ]
}